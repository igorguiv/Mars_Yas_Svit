<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
<LinearLayout
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="12dp">

    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/tvPlanTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="План · Yasno" android:textColor="#6B7280" android:textStyle="bold" android:textSize="12sp" />
        <TextView android:id="@+id/tvPlanGroup" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentEnd="true" android:layout_marginEnd="24dp" android:text=""
            android:textColor="#B45309" android:textStyle="bold" android:textSize="12sp" />
    </RelativeLayout>
    <ImageView android:id="@+id/ivPlan" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:adjustViewBounds="true" android:scaleType="fitXY" android:layout_marginTop="3dp" />
    <TextView android:id="@+id/tvPlanNext" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#374151" android:textSize="13sp" android:layout_marginTop="1dp" />

    <FrameLayout android:id="@+id/divider" android:layout_width="match_parent" android:layout_height="1dp"
        android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:background="#D3D6DD" />

    <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/tvFactTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Факт · СвітлоБот" android:textColor="#6B7280" android:textStyle="bold" android:textSize="12sp" />
        <TextView android:id="@+id/tvFactName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_alignParentEnd="true" android:text="" android:textColor="#6B7280" android:textSize="12sp" />
    </RelativeLayout>
    <ImageView android:id="@+id/ivFact" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:adjustViewBounds="true" android:scaleType="fitXY" android:layout_marginTop="3dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/tvFactDot" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#1FA578" android:textSize="13sp" android:layout_marginEnd="5dp" />
        <TextView android:id="@+id/tvFactStatus" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="" android:textColor="#374151" android:textSize="13sp"
            android:maxLines="2" />
    </LinearLayout>
    <TextView android:id="@+id/tvTime" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="end" android:text="" android:textColor="#9CA3AF" android:textSize="10sp"
        android:layout_marginTop="4dp" />
</LinearLayout>
    <ImageView
        android:id="@+id/ivRefresh"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_margin="3dp"
        android:padding="6dp"
        android:src="@drawable/ic_refresh"
        android:scaleType="fitCenter" />
</FrameLayout>
